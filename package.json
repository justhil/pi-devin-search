{
  "name": "pi-devin-search",
  "version": "0.1.0",
  "description": "Pi extension for Devin/Windsurf native GetWebSearchResults web search.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "devin",
    "windsurf",
    "web-search"
  ],
  "license": "MIT",
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "sql.js": "^1.14.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^22.15.0",
    "@types/sql.js": "^1.4.11",
    "tsx": "^4.23.12",
    "typebox": "*",
    "typescript": "^5.8.3"
  }
}
